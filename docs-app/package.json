{
  "name": "docs-app",
  "version": "0.0.0",
  "private": true,
  "description": "The Joinery guide, built with Kolay",
  "license": "MIT",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "scripts": {
    "build": "JOINERY_GUIDE=1 vite build --outDir ../docs/site/guide --emptyOutDir && cp ../docs/site/guide/index.html ../docs/site/404.html",
