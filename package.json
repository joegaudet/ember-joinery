{
  "name": "ember-joinery-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "repository": "https://github.com/joegaudet/ember-joinery",
  "scripts": {
    "barrels": "node scripts/gen-barrels.mjs",
    "build": "pnpm --filter './packages/*' run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter test-app test",
    "test:anchor-fallback": "JOINERY_ANCHOR_FALLBACK=1 pnpm --filter test-app test",
    "test:examples": "pnpm --filter './examples/*' --workspace-concurrency=1 run test",
    "parity": "node scripts/parity.mjs",
    "demo:build": "pnpm --filter test-app run build:demo",
    "guide:build": "pnpm --filter docs-app run build",
    "guide:start": "pnpm --filter docs-app start",
    "site:css": "node scripts/site-css.mjs",
    "site:screenshots": "node scripts/site-screenshots.mjs",
    "start": "pnpm --filter test-app start",
    "release": "pnpm build && node scripts/publish.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "cn": "0.2.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.6.1",
    "globals": "^16.4.0",
    "pixelmatch": "^7.2.0",
    "playwright-core": "1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
