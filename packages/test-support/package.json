{
  "name": "@ember-joinery/test-support",
  "version": "0.0.0",
  "description": "A test harness for every Joinery primitive and component, driven through data-test-jn selectors and ARIA.",
  "keywords": [
    "ember-addon",
    "ember",
    "testing",
    "harness",
    "joinery"
  ],
  "license": "MIT",
  "author": "Joe Gaudet <joe@joegaudet.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joegaudet/ember-joinery.git",
    "directory": "packages/test-support"
  },
  "homepage": "https://joegaudet.com/ember-joinery/",
  "bugs": "https://github.com/joegaudet/ember-joinery/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "files": [
    "addon-main.cjs",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/gen-barrels.mjs . && rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/gen-barrels.mjs . && tsc -p tsconfig.json --noEmit && tsc -p type-tests/tsconfig.json",
    "prepack": "node ../../scripts/gen-barrels.mjs . && node ../../scripts/legal-files.mjs . && rm -rf dist && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.3"
  },
  "peerDependencies": {
    "@ember/test-helpers": ">= 5.0.0"
  },
  "devDependencies": {
    "@ember/library-tsconfig": "^3.0.0",
    "@ember/test-helpers": "^5.7.0",
    "ember-source": "~7.3.0",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs"
  },
  "joinery": {
    "barrels": [
      "src"
    ]
  }
}
